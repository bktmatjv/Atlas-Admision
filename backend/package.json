{
  "name": "@atlas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:import": "tsx src/database/cli.ts import",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@atlas/motor": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "unpdf": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.0"
  }
}
