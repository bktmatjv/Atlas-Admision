# Configuración local. Copia este archivo a backend/.env; nunca subas secretos.
# Dentro de Compose se reemplaza DATABASE_URL por el servicio db.
DATABASE_URL=postgresql://atlas:atlas_local_only@127.0.0.1:55432/atlas
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8090
COOKIE_SAME_SITE=lax
# Sin clave, el tutor devuelve 503 explícito; práctica y extracción siguen disponibles.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=

# --- Router de modelos con failover (AI_PROVIDER=router) ---
# Cadena ordenada de proveedor:modelo (groq | cloudflare), separada por comas. El primero se prueba
# primero; si agota su cuota o falla, se pasa al siguiente. Los modelos de ejemplo pueden no estar
# disponibles en tu cuenta o plan: verifícalos en la consola de cada proveedor antes de usarlos.
# AI_PROVIDER=router
# AI_CADENA=groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-120b,cloudflare:@cf/google/gemma-4-26b-a4b-it
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Destinos de la cadena (separados por comas) que no resuelven herramientas; solo reciben llamadas sin ellas.
# AI_SIN_HERRAMIENTAS=
# Ajustes opcionales (valor por defecto entre paréntesis):
# AI_TIMEOUT_MS=20000          # por llamada a un destino
# AI_TIMEOUT_TOTAL_MS=45000    # por llamada al router, sumando reintentos y failovers
# AI_MAX_CONCURRENCIA=4        # llamadas simultáneas por destino
# AI_MAX_ESPERA_COLA_MS=5000   # espera máxima en la cola de un destino antes de probar el siguiente
# AI_ENFRIAMIENTO_MS=60000     # apertura del destino cuando el proveedor no informa cuándo se recupera
# AI_FALLOS_DISYUNTOR=3        # fallos transitorios seguidos que abren un destino
# Rutas opcionales. Por defecto, data/ y uploads/ dentro de backend/.
# DATA_DIR=/app/backend/data
# UPLOAD_DIR=/app/backend/uploads
