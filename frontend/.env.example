# Por defecto el servidor Vite reenvía /api al backend local.
VITE_API_URL=/api/v1
# Para una API separada: URL completa terminada en /api/v1; sin secretos.
# VITE_API_URL=https://api.example.com/api/v1

# Desarrollar solo el frontend contra una API desplegada (solo lo usa el servidor de Vite).
# Ojo: usa los datos reales y la cuota de IA de ese despliegue.
# API_PROXY_TARGET=https://calibra-demo.chilecentral.cloudapp.azure.com
# API_PROXY_ORIGIN=https://calibra-admission-nine.vercel.app
